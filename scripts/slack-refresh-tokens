#!/usr/bin/env bash
# slack-refresh-tokens — Refresh Slack MCP tokens from the desktop app
#
# Extracts xoxc/xoxd tokens directly from the Slack desktop app's local
# storage on disk. No browser window, no DevTools, no manual copy-paste.
#
# Every workspace the app is signed in to is extracted, not just the first:
# Slack keeps one xoxc token per workspace in localConfig_v2.teams, and a
# single `d` cookie shared across all of them.
#
# Requires: Slack desktop app installed and signed in, python3,
#           python3-cryptography, secret-tool (libsecret), curl
#
# Usage:
#   slack-refresh-tokens              # Auto-extract from desktop app
#   slack-refresh-tokens --validate   # Extract and validate with Slack API
#   slack-refresh-tokens --env        # Print tokens as env vars (for piping)
#   slack-refresh-tokens --help
#
# Token storage (compatible with setup-slack-mcp.py):
#   ~/.local/share/slack-mcp/workspaces.json   all workspaces
#   ~/.local/share/slack-mcp/tokens.env        default workspace only
#
# Works on Linux with GNOME Keyring. The Slack desktop app (Electron)
# encrypts cookies using a key stored in the system keyring. This script
# retrieves that key, decrypts the xoxd cookie, and extracts the xoxc
# tokens from leveldb.
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIR="${SLACK_MCP_DATA:-${HOME}/.local/share/slack-mcp}"
OUTPUT_FILE="${DATA_DIR}/tokens.env"
WORKSPACES_FILE="${DATA_DIR}/workspaces.json"
VALIDATE=false
ENV_MODE=false
DEFAULT_ALIAS=""

# Auto-detect Slack installation: Flatpak or native
if [[ -d "${HOME}/.var/app/com.slack.Slack/config/Slack" ]]; then
  SLACK_DIR="${HOME}/.var/app/com.slack.Slack/config/Slack"
elif [[ -d "${HOME}/.config/Slack" ]]; then
  SLACK_DIR="${HOME}/.config/Slack"
else
  SLACK_DIR=""
fi

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME [OPTIONS]

Extract Slack session tokens for every signed-in workspace from the desktop
app's local storage. Supports native and Flatpak installations (auto-detected).

Options:
  --validate        Validate every workspace against Slack's auth.test API
  --env             Print the default workspace's tokens as shell environment
                    variables to stdout (no file write)
  --output FILE     Write tokens.env to FILE instead of the default
                    ($OUTPUT_FILE)
  --workspaces FILE Write workspaces.json to FILE instead of the default
                    ($WORKSPACES_FILE)
  --default ALIAS   Make ALIAS the default workspace in workspaces.json
  --slack-dir D     Override auto-detected Slack data directory
  --help            Show this help

Requirements:
  - Slack desktop app installed and signed in
  - python3 with cryptography and secretstorage packages
  - curl (for --validate)

EOF
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --validate)   VALIDATE=true; shift ;;
    --env)        ENV_MODE=true; shift ;;
    --output)     OUTPUT_FILE="$2"; shift 2 ;;
    --workspaces) WORKSPACES_FILE="$2"; shift 2 ;;
    --default)    DEFAULT_ALIAS="$2"; shift 2 ;;
    --slack-dir)  SLACK_DIR="$2"; shift 2 ;;
    --help|-h)    usage ;;
    *)            echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done

# --- Preflight checks ---
if [[ -z "$SLACK_DIR" || ! -d "$SLACK_DIR" ]]; then
  echo "ERROR: Slack desktop app not found." >&2
  echo "Checked: ~/.config/Slack (native) and ~/.var/app/com.slack.Slack/config/Slack (Flatpak)" >&2
  echo "Install Slack or use --slack-dir to specify the location." >&2
  exit 1
fi

echo "Using Slack data directory: $SLACK_DIR" >&2

if [[ ! -f "$SLACK_DIR/Cookies" ]]; then
  echo "ERROR: No Cookies database — is the Slack app signed in?" >&2
  exit 1
fi

if ! command -v python3 &>/dev/null; then
  echo "ERROR: python3 not found" >&2
  exit 1
fi

if ! python3 -c "from cryptography.hazmat.primitives.ciphers import Cipher" 2>/dev/null; then
  echo "ERROR: python3 cryptography package not found" >&2
  echo "Install it: pip install cryptography" >&2
  exit 1
fi

if ! python3 -c "import secretstorage" 2>/dev/null; then
  echo "ERROR: python3 secretstorage package not found" >&2
  echo "Install it: pip install secretstorage" >&2
  exit 1
fi

# --- Extract every workspace; emits a JSON payload on stdout ---
export SLACK_DIR SCRIPT_DIR
payload=$(python3 - <<'PY'
import hashlib
import json
import os
import sqlite3
import sys
from pathlib import Path

sys.path.insert(0, os.environ["SCRIPT_DIR"])
from slack_workspaces import accounts_from_teams, extract_local_config, find_teams_by_proximity

import secretstorage

slack_dir = Path(os.environ["SLACK_DIR"])

# --- Get encryption key from system keyring ---
# Supports both native ('application'='Slack') and Flatpak
# ('server'='Slack Keys', 'user'='Slack Safe Storage') keyring entries.
bus = secretstorage.dbus_init()
keyring_pass = None
for coll in secretstorage.get_all_collections(bus):
    if coll.is_locked():
        continue
    try:
        for item in coll.get_all_items():
            attrs = item.get_attributes()
            if attrs.get('application') == 'Slack':
                keyring_pass = item.get_secret().decode()
                break
            if attrs.get('user') == 'Slack Safe Storage' and attrs.get('server') == 'Slack Keys':
                keyring_pass = item.get_secret().decode()
                break
    except Exception:
        pass
    if keyring_pass:
        break

if not keyring_pass:
    print('ERROR: No Slack encryption key in system keyring.', file=sys.stderr)
    print('Is the Slack desktop app signed in?', file=sys.stderr)
    sys.exit(1)

# --- xoxd: decrypt from Cookies SQLite (one cookie for every workspace) ---
key = hashlib.pbkdf2_hmac('sha1', keyring_pass.encode(), b'saltysalt', 1, dklen=16)

conn = sqlite3.connect(str(slack_dir / 'Cookies'))
row = conn.execute(
    "SELECT encrypted_value FROM cookies WHERE name = 'd' AND host_key = '.slack.com'"
).fetchone()
conn.close()

if not row:
    print('ERROR: No session cookie found in Slack Cookies DB.', file=sys.stderr)
    sys.exit(1)

from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
ciphertext = row[0][3:]  # skip v10/v11 prefix
cipher = Cipher(algorithms.AES(key), modes.CBC(b'\x00' * 16))
dec = cipher.decryptor()
decrypted = dec.update(ciphertext) + dec.finalize()
pad_len = decrypted[-1]
if 0 < pad_len <= 16:
    decrypted = decrypted[:-pad_len]
text = decrypted.decode('utf-8', errors='replace')
idx = text.find('xoxd-')
if idx < 0:
    print('ERROR: xoxd token not found in decrypted cookie.', file=sys.stderr)
    sys.exit(1)
xoxd = text[idx:]

# --- xoxc: every team in localConfig_v2, newest leveldb files first ---
ldb_dir = slack_dir / 'Local Storage' / 'leveldb'


def _mtime(path):
    try:
        return path.stat().st_mtime
    except OSError:
        return -1


files = sorted(
    (p for p in ldb_dir.glob('*') if p.suffix in ('.log', '.ldb')),
    key=_mtime,
    reverse=True,
)

teams = {}
for path in files:
    try:
        blob = path.read_bytes()
    except OSError:
        continue
    config = extract_local_config(blob)
    found = (config or {}).get('teams') or {}
    if not found:
        # localConfig_v2 can be split across leveldb blocks; recover what we can.
        found = find_teams_by_proximity(blob)
    for team_id, team in found.items():
        teams.setdefault(team_id, team)  # newest file wins

accounts = accounts_from_teams(teams)
if not accounts:
    print('ERROR: no xoxc tokens found in Slack Local Storage.', file=sys.stderr)
    print('Is the Slack desktop app signed in to at least one workspace?', file=sys.stderr)
    sys.exit(1)

print(json.dumps({'xoxd': xoxd, 'accounts': accounts}))
PY
)

if [[ -z "$payload" ]]; then
  echo "ERROR: Token extraction failed." >&2
  exit 1
fi

export PAYLOAD="$payload"

# --- Output ---
if [[ "$ENV_MODE" == true ]]; then
  python3 - <<'PY'
import json
import os

payload = json.loads(os.environ["PAYLOAD"])
accounts = payload["accounts"]
print(f"# {len(accounts)} workspace(s): " + ", ".join(
    a["domain"] or a["team_name"] or a["team_id"] for a in accounts
))
print(f"SLACK_MCP_XOXC_TOKEN={accounts[0]['xoxc']}")
print(f"SLACK_MCP_XOXD_TOKEN={payload['xoxd']}")
PY
  exit 0
fi

export OUTPUT_FILE WORKSPACES_FILE DEFAULT_ALIAS SCRIPT_NAME
python3 - <<'PY'
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, os.environ["SCRIPT_DIR"])
from slack_workspaces import merge_workspaces, read_workspaces, write_tokens_env, write_workspaces

payload = json.loads(os.environ["PAYLOAD"])
accounts = payload["accounts"]
xoxd = payload["xoxd"]

workspaces_file = Path(os.environ["WORKSPACES_FILE"])
tokens_file = Path(os.environ["OUTPUT_FILE"])
requested_default = os.environ.get("DEFAULT_ALIAS") or None

config = merge_workspaces(read_workspaces(workspaces_file), accounts, xoxd, requested_default)
write_workspaces(workspaces_file, config)

default_alias = config.get("default", "")
default_entry = config.get("accounts", {}).get(default_alias, {})
write_tokens_env(
    tokens_file,
    default_entry.get("xoxc", accounts[0]["xoxc"]),
    xoxd,
    default_entry.get("team_id", ""),
    os.environ.get("SCRIPT_NAME", ""),
)

print(f"Workspaces saved to {workspaces_file}")
for alias, entry in config.get("accounts", {}).items():
    token = entry.get("xoxc") or entry.get("bot_token") or ""
    marker = "  [default]" if alias == default_alias else ""
    shown = f"{token[:15]}...{token[-8:]}" if len(token) > 23 else (token or "(no token)")
    print(f"  {alias:<20} {entry.get('team_id', ''):<12} {shown}{marker}")
print(f"Default workspace tokens also written to {tokens_file}")
print(f"  xoxd: {xoxd[:15]}...{xoxd[-8:]}")
PY

# --- Validate ---
if [[ "$VALIDATE" == true ]]; then
  if ! command -v curl &>/dev/null; then
    echo "WARNING: curl not found — skipping validation" >&2
    exit 0
  fi
  failures=0
  while IFS=$'\t' read -r alias xoxc; do
    [[ -z "$alias" ]] && continue
    team=$(curl -s "https://slack.com/api/auth.test" \
      -H "Authorization: Bearer $xoxc" \
      -b "d=$(python3 -c 'import json,os;print(json.loads(os.environ["PAYLOAD"])["xoxd"])')" \
      | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except ValueError:
    d = {}
print(d.get("team", "") if d.get("ok") else "FAILED: " + d.get("error", "unknown"))')
    if [[ "$team" == FAILED:* ]]; then
      echo "  $alias: ${team}" >&2
      failures=$((failures + 1))
    else
      echo "  $alias: ok ($team)"
    fi
  done < <(python3 - <<'PY'
import json
import os

payload = json.loads(os.environ["PAYLOAD"])
for account in payload["accounts"]:
    print(f"{account['domain'] or account['team_id']}\t{account['xoxc']}")
PY
)
  if (( failures > 0 )); then
    echo "WARNING: $failures workspace(s) failed auth.test — those tokens may be expired." >&2
    exit 1
  fi
  echo "Validated: all workspaces are working."
fi
